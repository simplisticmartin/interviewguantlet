# ---------------------------------------------------------------------------
# Gauntlet configuration. Copy to `.env` and fill in.
# Every value here has a working default EXCEPT the provider API key.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
GAUNTLET_ENV=development
GAUNTLET_SECRET_KEY=change-me-in-production-use-a-long-random-string
GAUNTLET_CORS_ORIGINS=http://localhost:5173

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml defaults.
GAUNTLET_DATABASE_URL=postgresql+psycopg://gauntlet:gauntlet@localhost:5433/gauntlet
GAUNTLET_REDIS_URL=redis://localhost:6380/0


# ===========================================================================
# MODEL PROVIDER
# ===========================================================================
# Pick one provider key below and set its API key. Model defaults come from
# gauntlet/llm/providers/presets.py and can be overridden here.
#
# Leave this as `scripted` to run a complete interview with no key at all,
# using the deterministic offline engine.
#
GAUNTLET_LLM_PROVIDER=scripted


# --- Frontier labs ---------------------------------------------------------

# Anthropic (Claude). Native adapter, structured output via forced tool use.
# ANTHROPIC_API_KEY=
#   GAUNTLET_LLM_PROVIDER=anthropic

# OpenAI. Also the default source of embeddings.
# OPENAI_API_KEY=
#   GAUNTLET_LLM_PROVIDER=openai

# Google Gemini. Key from Google AI Studio (aistudio.google.com), NOT the
# gemini.google.com chat app. Uses Google's OpenAI compatibility layer.
# GEMINI_API_KEY=
#   GAUNTLET_LLM_PROVIDER=gemini

# DeepSeek. Very strong price to performance. No embeddings.
# Use deepseek-reasoner for the judges if you want reasoning at higher latency.
# DEEPSEEK_API_KEY=
#   GAUNTLET_LLM_PROVIDER=deepseek

# xAI (Grok). Key from console.x.ai, NOT the grok.com chat app.
# XAI_API_KEY=
#   GAUNTLET_LLM_PROVIDER=xai

# Moonshot AI (Kimi). Key from platform.moonshot.ai, NOT the kimi.com chat app.
# China-platform accounts should set GAUNTLET_LLM_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_API_KEY=
#   GAUNTLET_LLM_PROVIDER=moonshot

# Alibaba Qwen via DashScope / Model Studio. NOT the chat.qwen.ai app.
# Defaults to the international endpoint. Mainland China accounts should set
# GAUNTLET_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
#   GAUNTLET_LLM_PROVIDER=qwen

# Mistral AI.
# MISTRAL_API_KEY=
#   GAUNTLET_LLM_PROVIDER=mistral

# Cohere, via its OpenAI compatibility endpoint.
# COHERE_API_KEY=
#   GAUNTLET_LLM_PROVIDER=cohere


# --- Fast inference hosts for open weight models ---------------------------
# These serve Llama, Qwen, DeepSeek and similar. Good for the cheap calls
# (response classification, routing) where latency matters more than depth.

# GROQ_API_KEY=            #   GAUNTLET_LLM_PROVIDER=groq
# CEREBRAS_API_KEY=        #   GAUNTLET_LLM_PROVIDER=cerebras
# TOGETHER_API_KEY=        #   GAUNTLET_LLM_PROVIDER=together
# FIREWORKS_API_KEY=       #   GAUNTLET_LLM_PROVIDER=fireworks
# DEEPINFRA_API_KEY=       #   GAUNTLET_LLM_PROVIDER=deepinfra
# NEBIUS_API_KEY=          #   GAUNTLET_LLM_PROVIDER=nebius
# SAMBANOVA_API_KEY=       #   GAUNTLET_LLM_PROVIDER=sambanova
# HYPERBOLIC_API_KEY=      #   GAUNTLET_LLM_PROVIDER=hyperbolic


# --- Routers and aggregators -----------------------------------------------

# OpenRouter. One key, hundreds of models across every major vendor, chosen by
# the model string. The easiest way to try many providers without many accounts.
# OPENROUTER_API_KEY=
#   GAUNTLET_LLM_PROVIDER=openrouter
#   GAUNTLET_LLM_INTERVIEW_MODEL=anthropic/claude-sonnet-4
#   GAUNTLET_LLM_EVALUATION_MODEL=deepseek/deepseek-chat

# Perplexity. Search-grounded models. Poor fit for grading, which must not search.
# PERPLEXITY_API_KEY=      #   GAUNTLET_LLM_PROVIDER=perplexity

# GitHub Models. Free tier with a GitHub token, heavily rate limited.
# GITHUB_TOKEN=            #   GAUNTLET_LLM_PROVIDER=github

# Azure OpenAI. Model names are your DEPLOYMENT names, not upstream model names.
# AZURE_OPENAI_API_KEY=
#   GAUNTLET_LLM_PROVIDER=azure
#   GAUNTLET_LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1


# --- Local and self hosted, no key required --------------------------------
# Nothing leaves your machine. Small local models are noticeably weaker at
# rubric grading, so run `python -m evals.runner` before trusting the scores.

# Ollama:    ollama pull qwen2.5:14b
#   GAUNTLET_LLM_PROVIDER=ollama
# LM Studio: start the local server in the app first
#   GAUNTLET_LLM_PROVIDER=lmstudio
# vLLM:      GAUNTLET_LLM_PROVIDER=vllm
# llama.cpp: GAUNTLET_LLM_PROVIDER=llamacpp


# --- Anything else ---------------------------------------------------------
# Any gateway speaking the OpenAI chat completions format works, including
# LiteLLM and internal company gateways.
#   GAUNTLET_LLM_PROVIDER=custom
#   GAUNTLET_LLM_BASE_URL=https://your-gateway.example.com/v1
#   GAUNTLET_LLM_API_KEY=your-key
#   GAUNTLET_LLM_INTERVIEW_MODEL=your-model
#   GAUNTLET_LLM_EVALUATION_MODEL=your-model


# --- Model overrides (optional) --------------------------------------------
# Model names change often. If a call fails with "model not found", set these.
# GAUNTLET_LLM_INTERVIEW_MODEL=
# GAUNTLET_LLM_EVALUATION_MODEL=

GAUNTLET_LLM_MAX_RETRIES=3
GAUNTLET_LLM_TIMEOUT_SECONDS=90


# ===========================================================================
# EMBEDDINGS
# ===========================================================================
# Resolved independently of the chat provider, because several strong chat
# providers (DeepSeek, xAI, Groq, Moonshot, Cerebras) have NO embedding
# endpoint at all. Embeddings power question retrieval and deduplication.
#
#   auto  = use the chat provider if it can embed, else OpenAI if a key is
#           present, else the deterministic local fallback
#   local = always use the local hash embedder (offline, not semantic)
#   <key> = any provider key that supports embeddings
#
# Providers that support embeddings: openai, gemini, qwen, mistral, cohere,
# together, fireworks, deepinfra, nebius, github, azure, ollama
#
GAUNTLET_EMBEDDING_PROVIDER=auto
# GAUNTLET_EMBEDDING_API_KEY=
# GAUNTLET_EMBEDDING_BASE_URL=
# GAUNTLET_EMBEDDING_MODEL=
GAUNTLET_EMBEDDING_DIM=1536

# Example: interview on DeepSeek, embed with OpenAI
#   GAUNTLET_LLM_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=...
#   GAUNTLET_EMBEDDING_PROVIDER=openai
#   OPENAI_API_KEY=...


# --- Interview behaviour ---------------------------------------------------
GAUNTLET_DEFAULT_INTERVIEW_MINUTES=20
GAUNTLET_MAX_QUESTIONS_PER_INTERVIEW=14
GAUNTLET_MULTI_JUDGE_ENABLED=true

# --- Observability ---------------------------------------------------------
# Spans are always created. With no SDK installed they hit OpenTelemetry's no-op
# tracer and cost nothing, so this only controls whether anything collects them.
#
#   pip install -e ".[otel]"
#   GAUNTLET_OTEL_ENABLED=true
#
# Leave the endpoint empty to print spans to the console, which is useful locally and
# makes a misconfigured collector obvious rather than silent.
GAUNTLET_OTEL_ENABLED=false
GAUNTLET_OTEL_SERVICE_NAME=gauntlet-api
# GAUNTLET_OTEL_ENDPOINT=http://localhost:4317

# --- Uploads ---------------------------------------------------------------
GAUNTLET_UPLOAD_DIR=./uploads
GAUNTLET_MAX_UPLOAD_BYTES=5242880

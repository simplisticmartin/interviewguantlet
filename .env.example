# ---------------------------------------------------------------------------
# Gauntlet configuration. Copy to `.env` and fill in.
# Every value here has a working default EXCEPT the provider API key.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
GAUNTLET_ENV=development
GAUNTLET_SECRET_KEY=change-me-in-production-use-a-long-random-string
GAUNTLET_CORS_ORIGINS=http://localhost:5173

# --- Database --------------------------------------------------------------
# Matches infra/docker-compose.yml defaults.
GAUNTLET_DATABASE_URL=postgresql+psycopg://gauntlet:gauntlet@localhost:5433/gauntlet
GAUNTLET_REDIS_URL=redis://localhost:6380/0

# --- LLM providers ---------------------------------------------------------
# provider: anthropic | openai | scripted
#   anthropic -> interviewing + evaluation (recommended)
#   openai    -> alternative, also supplies embeddings
#   scripted  -> deterministic, no network, no key. Used by tests; fine for a UI demo.
GAUNTLET_LLM_PROVIDER=scripted

ANTHROPIC_API_KEY=
GAUNTLET_ANTHROPIC_INTERVIEW_MODEL=claude-opus-5
GAUNTLET_ANTHROPIC_EVALUATION_MODEL=claude-sonnet-5

OPENAI_API_KEY=
GAUNTLET_OPENAI_INTERVIEW_MODEL=gpt-4.1
GAUNTLET_OPENAI_EVALUATION_MODEL=gpt-4.1-mini

# Embeddings are always served by OpenAI when a key is present, otherwise a
# deterministic local hash embedder is used (dev/test only, not for production RAG).
GAUNTLET_EMBEDDING_MODEL=text-embedding-3-small
GAUNTLET_EMBEDDING_DIM=1536

# --- Interview behaviour ---------------------------------------------------
GAUNTLET_DEFAULT_INTERVIEW_MINUTES=20
GAUNTLET_MAX_QUESTIONS_PER_INTERVIEW=14
GAUNTLET_MULTI_JUDGE_ENABLED=true

# --- Uploads ---------------------------------------------------------------
GAUNTLET_UPLOAD_DIR=./uploads
GAUNTLET_MAX_UPLOAD_BYTES=5242880
